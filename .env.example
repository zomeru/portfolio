# Deployment and Sanity
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_APP_ID=your-app-id
SANITY_API_TOKEN=your-sanity-token


# GitHub activity (server only)
GH_PAT_TOKEN=your-github-personal-access-token

# Blog generation
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.7-flash
CRON_SECRET=replace-with-at-least-32-random-characters

# Ask Zomer AI
DATABASE_URL=your_pooled_database_url
DATABASE_DIRECT_URL=your_direct_database_url
AI_INDEX_SECRET_KEY=replace-with-at-least-32-random-characters
AI_CHAT_PROVIDER=groq # groq | nvidia | openrouter
OPENROUTER_API_KEY=your-openrouter-key
# Only the API key for the selected chat provider is required; OpenRouter remains required for embeddings.
NVIDIA_NIM_API_KEY=your-nvidia-nim-key
GROQ_API_KEY=your-groq-key
AI_OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_NVIDIA_NIM_CHAT_MODEL=deepseek-ai/deepseek-v4-flash-0731
AI_GROQ_CHAT_MODEL=openai/gpt-oss-120b
AI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# Optional observability; configure both keys or neither.
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
