{
  "name": "@portfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/next.ts",
    "./public-portfolio": "./src/public-portfolio.ts",
    "./public-portfolio/testing": "./src/public-portfolio-testing.ts",
    "./logging": "./src/logging.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "ai:eval": "pnpm run with-env tsx src/evaluations/run.ts",
    "ai:index": "pnpm run with-env tsx src/cli/index-knowledge.ts",
    "ai:index:prod": "pnpm run with-env:prod tsx src/cli/index-knowledge.ts",
    "check-types": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test 'src/**/*.test.ts'",
    "with-env": "pnpm exec dotenv -e ../../.env.local --",
    "with-env:prod": "pnpm exec dotenv -e ../../.env.production.local --"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/groq": "^4.0.30",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@langfuse/tracing": "^5.10.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@portabletext/toolkit": "^6.0.0",
    "@portfolio/content": "workspace:*",
    "@portfolio/database": "workspace:*",
    "@portfolio/env": "workspace:*",
    "@sanity/client": "^7.26.2",
    "ai": "^7.0.77",
    "groq": "^6.10.1",
    "hono": "^4.13.3",
    "nodemailer": "^9.0.5",
    "resend": "^6.22.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@portfolio/typescript-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
