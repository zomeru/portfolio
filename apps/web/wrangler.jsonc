{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-local",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "PORTFOLIO_RUNTIME": "workers" },
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
  },
  "env": {
    "production": {
      "name": "portfolio",
      "routes": [{ "pattern": "zomeru.dev", "custom_domain": true }],
      "triggers": { "crons": ["0 22 * * TUE,THU,SAT"] },
      "vars": {
        "PORTFOLIO_RUNTIME": "workers",
        "NODE_ENV": "production",
        "SITE_URL": "https://zomeru.dev",
        "SANITY_PROJECT_ID": "fvmu1iv8",
        "SANITY_DATASET": "production",
        "SANITY_APP_ID": "c8bcdbwo8f790dksxt7x57yy",
        "GOOGLE_GENERATIVE_AI_MODEL": "gemini-3.8-flash",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM_NAME": "Zomer Gregorio",
        "EMAIL_CONFIRMATION_TTL_HOURS": "24",
        "AI_CHAT_PROVIDER": "groq",
        "AI_OPENROUTER_CHAT_MODEL": "nvidia/nemotron-3-super-120b-a12b:free",
        "AI_NVIDIA_NIM_CHAT_MODEL": "deepseek-ai/deepseek-v4-flash-0731",
        "AI_GROQ_CHAT_MODEL": "openai/gpt-oss-120b",
        "AI_EMBEDDING_MODEL": "nvidia/nemotron-3-embed-1b:free",
        "LANGFUSE_BASE_URL": "https://jp.cloud.langfuse.com",
        // Fill in each optional integration's values alongside its matching secrets.
        "EMAIL_FROM": "Zomer Gregorio",
        "EMAIL_REPLY_TO": "hello@zomeru.dev",
        "WEB_PUSH_VAPID_PUBLIC_KEY": "your-vapid-public-key",
        "WEB_PUSH_SUBJECT": "mailto:hello@zomeru.dev",
        "WEBHOOK_RELAY_URL": "",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-cef3d33a-eb8d-4e76-9695-194a1a83f330",
      },
    },
    "staging": {
      "name": "portfolio-staging",
      "routes": [{ "pattern": "preview.zomeru.dev", "custom_domain": true }],
      "triggers": { "crons": [] },
      "vars": {
        "PORTFOLIO_RUNTIME": "workers",
        "NODE_ENV": "production",
        "SITE_URL": "https://preview.zomeru.dev",
        "SANITY_PROJECT_ID": "fvmu1iv8",
        "SANITY_DATASET": "development",
        "SANITY_APP_ID": "c8bcdbwo8f790dksxt7x57yy",
        "GOOGLE_GENERATIVE_AI_MODEL": "gemini-3.8-flash",
        "EMAIL_PROVIDER": "resend",
        "EMAIL_FROM_NAME": "Zomer Gregorio",
        "EMAIL_CONFIRMATION_TTL_HOURS": "24",
        "AI_CHAT_PROVIDER": "groq",
        "AI_OPENROUTER_CHAT_MODEL": "nvidia/nemotron-3-super-120b-a12b:free",
        "AI_NVIDIA_NIM_CHAT_MODEL": "deepseek-ai/deepseek-v4-flash-0731",
        "AI_GROQ_CHAT_MODEL": "openai/gpt-oss-120b",
        "AI_EMBEDDING_MODEL": "nvidia/nemotron-3-embed-1b:free",
        "LANGFUSE_BASE_URL": "https://jp.cloud.langfuse.com",
        // Fill in each optional integration's values alongside its matching secrets.
        "EMAIL_FROM": "Zomer Gregorio",
        "EMAIL_REPLY_TO": "hello@zomeru.dev",
        "WEB_PUSH_VAPID_PUBLIC_KEY": "BNs9md7LmGcRqNoTegY8Ef_5zKxSvqeC3R04OoT79mOfwejV1bWBOhdVmrR6xiJU2N8g1-am55DrbPVoOf3aENE",
        "WEB_PUSH_SUBJECT": "mailto:hello@zomeru.dev",
        "WEBHOOK_RELAY_URL": "",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-cef3d33a-eb8d-4e76-9695-194a1a83f330",
      },
    },
  },
}
