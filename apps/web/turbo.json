{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**", "!dist/**/.dev.vars*", ".wrangler/deploy/config.json"],
      "env": ["CLOUDFLARE_ENV"]
    },
    "deploy:production": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN", "WRANGLER_SEND_METRICS"]
    },
    "deploy:staging": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN", "WRANGLER_SEND_METRICS"]
    },
    "check-types": {
      "outputs": ["src/routeTree.gen.ts", "worker-configuration.d.ts"]
    }
  }
}
