{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "ADMIN_ACCESS_KEY",
        "DATABASE_URL",
        "AI_INDEX_SECRET_KEY",
        "AI_CHAT_PROVIDER",
        "OPENROUTER_API_KEY",
        "NVIDIA_NIM_API_KEY",
        "GROQ_API_KEY",
        "AI_OPENROUTER_CHAT_MODEL",
        "AI_NVIDIA_NIM_CHAT_MODEL",
        "AI_GROQ_CHAT_MODEL",
        "AI_EMBEDDING_MODEL",
        "LANGFUSE_PUBLIC_KEY",
        "LANGFUSE_SECRET_KEY",
        "LANGFUSE_BASE_URL",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "GOOGLE_GENERATIVE_AI_MODEL",
        "CRON_SECRET",
        "EMAIL_PROVIDER",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_FROM_NAME",
        "EMAIL_REPLY_TO",
        "EMAIL_CONFIRMATION_TTL_HOURS",
        "GOOGLE_APP_PASSWORD",
        "NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY",
        "WEB_PUSH_VAPID_PRIVATE_KEY",
        "WEB_PUSH_SUBJECT",
        "NOTIFICATION_TOKEN_SECRET",
        "WEBHOOK_ENCRYPTION_KEY",
        "SANITY_API_TOKEN",
        "SANITY_REVALIDATE_SECRET",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SANITY_APP_ID",
        "NEXT_PUBLIC_SITE_URL",
        "GH_PAT_TOKEN",
        "ENABLE_EXPERIMENTAL_COREPACK"
      ]
    },
    "check-types": {
      "outputs": [".next/types/**"]
    }
  }
}
