{
  "name": "@portfolio/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run build && wrangler deploy",
    "cf:typegen": "wrangler types --env-file ../../.env.example --strict-vars=false",
    "cron:blog": "pnpm run with-env tsx scripts/run-blog-cron.ts",
    "check-types": "pnpm run cf:typegen && tsr generate && tsc --noEmit",
    "with-env": "pnpm exec dotenv -e ../../.env.local --"
  },
  "dependencies": {
