{
  "name": "@portfolio/studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run with-env sanity build",
    "deploy": "pnpm run with-env sanity deploy",
    "deploy-graphql": "pnpm run with-env sanity graphql deploy",
    "dev": "pnpm run with-env sanity dev",
    "start": "pnpm run with-env sanity start",
    "check-types": "tsc --noEmit",
    "blog:label-code": "tsx scripts/label-blog-code-fences.ts",
    "seed": "pnpm run with-env tsx scripts/seed.ts",
    "typegen": "pnpm run with-env sanity schema extract --workspace development --path schema.json --enforce-required-fields --force && pnpm run with-env sanity typegen generate",
    "with-env": "pnpm exec dotenv -e ../../.env.local --"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portfolio/content": "workspace:*",
    "@portfolio/env": "workspace:*",
    "@sanity/icons": "^5.3.0",
    "@sanity/vision": "^6.23.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "^6.23.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@portfolio/typescript-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
