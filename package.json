{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e .env.local --",
    "prepare": "husky",
    "reset": "pnpm run clean && pnpm install && pnpm run db:generate",
    "dev": "turbo run dev --filter=@portfolio/web",
    "dev:all": "turbo run dev",
    "build": "turbo run build --filter=@portfolio/web",
    "build:all": "turbo run build",
    "kill:ports": "kill $(lsof -tiTCP:3000-3005 -iTCP:8787 -sTCP:LISTEN 2>/dev/null) 2>/dev/null || true",
    "db:generate": "turbo run db:generate --filter=@portfolio/database",
    "db:migrate": "turbo run db:migrate --filter=@portfolio/database",
    "db:push": "turbo run db:push --filter=@portfolio/database",
    "db:pull": "turbo run db:pull --filter=@portfolio/database",
    "db:export": "turbo run db:export --filter=@portfolio/database",
    "db:check": "turbo run db:check --filter=@portfolio/database",
    "db:up": "turbo run db:up --filter=@portfolio/database",
    "db:studio": "turbo run db:studio --filter=@portfolio/database",
    "studio:seed": "turbo run seed --filter=@portfolio/studio",
    "studio:deploy": "turbo run deploy --filter=@portfolio/studio",
    "check:all": "pnpm run lint && pnpm run deps:check && pnpm run deps:unused && pnpm run check-types",
    "check:all:build": "pnpm run check:all && pnpm run build:all && pnpm run security:check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check-types": "turbo run check-types",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:unused": "pnpm run with-env knip",
    "security:audit": "pnpm audit --prod",
    "security:check": "pnpm audit",
    "version:packages": "changeset version",
    "version:sync": "tsx scripts/sync-version.ts",
    "changeset": "changeset",
    "clean": "rimraf node_modules .pnpm-store .turbo dist apps/*/{node_modules,.turbo,dist,.output} packages/*/{node_modules,.turbo,dist,.output}"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "rimraf": "^6.1.3",
    "syncpack": "^15.3.3",
    "tsx": "^4.23.12",
    "turbo": "2.10.10",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*": "biome check --no-errors-on-unmatched --write --files-ignore-unknown=true",
    "*.{ts,tsx}": "biome check --no-errors-on-unmatched --write --files-ignore-unknown=true"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "warn"
    }
  }
}
