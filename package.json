{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e .env.local --",
    "prepare": "husky",
    "reset": "pnpm run clean && pnpm install && pnpm run db:generate",
    "dev": "turbo run dev --filter=@portfolio/web",
    "dev:all": "turbo run dev",
    "build": "turbo run build --filter=@portfolio/web",
    "build:production": "turbo run build:production --filter=@portfolio/web",
    "build:all": "turbo run build",
    "deploy:production": "turbo run deploy:production --filter=@portfolio/web --",
    "deploy:staging": "turbo run deploy:staging --filter=@portfolio/web --",
    "versions:upload": "turbo run versions:upload --filter=@portfolio/web --",
    "versions:upload:production": "turbo run versions:upload:production --filter=@portfolio/web --",
    "ai:eval": "turbo run ai:eval --filter=@portfolio/api --",
    "ai:index": "turbo run ai:index --filter=@portfolio/api --",
    "ai:index:prod": "turbo run ai:index:prod --filter=@portfolio/api --",
    "cron:blog": "pnpm --filter @portfolio/web run cron:blog",
    "db:generate": "turbo run db:generate --filter=@portfolio/database",
    "db:migrate": "turbo run db:migrate --filter=@portfolio/database",
    "db:push": "turbo run db:push --filter=@portfolio/database",
    "db:pull": "turbo run db:pull --filter=@portfolio/database",
    "db:export": "turbo run db:export --filter=@portfolio/database",
    "db:check": "turbo run db:check --filter=@portfolio/database",
    "db:up": "turbo run db:up --filter=@portfolio/database",
    "db:studio": "turbo run db:studio --filter=@portfolio/database",
    "studio:seed": "turbo run seed --filter=@portfolio/studio",
    "studio:deploy": "turbo run deploy --filter=@portfolio/studio",
    "check:all": "pnpm run lint && pnpm run boundaries && pnpm run deps:check && pnpm run check-types && pnpm run deps:unused && pnpm run test",
    "check:all:build": "pnpm run check:all && pnpm run build:all",
    "lint": "pnpm run format:check && oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types",
    "boundaries": "turbo boundaries",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:unused": "knip",
    "security:audit": "pnpm audit --prod",
    "security:check": "pnpm audit",
    "security:secrets": "tsx scripts/run-ggshield.ts",
    "test": "turbo run test",
    "version:packages": "changeset version",
    "version:sync": "tsx scripts/sync-version.ts",
    "changeset": "changeset",
    "clean": "rimraf node_modules .pnpm-store .turbo dist apps/*/{node_modules,.turbo,dist,.output} packages/*/{node_modules,.turbo,dist,.output}",
    "preview": "pnpm --filter @portfolio/web run preview",
    "cf:typegen": "pnpm --filter @portfolio/web run cf:typegen"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.1.0",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "rimraf": "^6.1.4",
    "syncpack": "^15.3.3",
    "tsx": "catalog:",
    "turbo": "2.11.11",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,less,html,md,mdx,yaml,yml,graphql,gql}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "warn"
    }
  }
}
