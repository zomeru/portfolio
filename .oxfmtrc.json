{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/.agents",
    "**/.claude",
    "**/.opencode",
    "**/.codex",
    "**/.turbo",
    "**/.next",
    "**/dist",
    "**/node_modules",
    "**/coverage",
    "**/public",
    "**/out",
    "**/graphify-out",
    "**/drizzle",
    "**/sanity.types.ts",
    "apps/studio/data",
    ".vercelignore"
  ]
}
