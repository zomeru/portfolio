{
  "$schema": "node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": ["pnpm-workspace.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "GOOGLE_GENERATIVE_AI_MODEL",
        "CRON_SECRET",
        "SANITY_API_TOKEN",
        "NEXT_PUBLIC_SANITY_DATASET",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": ["drizzle/**"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:pull": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:export": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:check": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:up": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "seed": {
      "cache": false,
      "env": ["SANITY_API_TOKEN", "NEXT_PUBLIC_SANITY_DATASET"]
    },
    "deploy": {
      "cache": false,
      "env": ["SANITY_API_TOKEN", "NEXT_PUBLIC_SANITY_DATASET"]
    }
  }
}
