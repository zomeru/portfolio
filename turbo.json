{
  "$schema": "node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": ["pnpm-workspace.yaml"],
  "tasks": {
    "analyze": {
      "cache": false
    },
    "ai:eval": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "AI_INDEX_SECRET_KEY",
        "AI_CHAT_PROVIDER",
        "OPENROUTER_API_KEY",
        "NVIDIA_NIM_API_KEY",
        "GROQ_API_KEY",
        "AI_OPENROUTER_CHAT_MODEL",
        "AI_NVIDIA_NIM_CHAT_MODEL",
        "AI_GROQ_CHAT_MODEL",
        "AI_EMBEDDING_MODEL"
      ]
    },
    "ai:index": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "AI_INDEX_SECRET_KEY",
        "AI_CHAT_PROVIDER",
        "OPENROUTER_API_KEY",
        "NVIDIA_NIM_API_KEY",
        "GROQ_API_KEY",
        "AI_OPENROUTER_CHAT_MODEL",
        "AI_NVIDIA_NIM_CHAT_MODEL",
        "AI_GROQ_CHAT_MODEL",
        "AI_EMBEDDING_MODEL",
        "SANITY_API_TOKEN",
        "NEXT_PUBLIC_SANITY_DATASET"
      ]
    },
    "ai:index:prod": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "AI_INDEX_SECRET_KEY",
        "AI_CHAT_PROVIDER",
        "OPENROUTER_API_KEY",
        "NVIDIA_NIM_API_KEY",
        "GROQ_API_KEY",
        "AI_OPENROUTER_CHAT_MODEL",
        "AI_NVIDIA_NIM_CHAT_MODEL",
        "AI_GROQ_CHAT_MODEL",
        "AI_EMBEDDING_MODEL",
        "SANITY_API_TOKEN",
        "NEXT_PUBLIC_SANITY_DATASET"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": ["drizzle/**"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:pull": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:export": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:check": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:up": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "DATABASE_DIRECT_URL"]
    },
    "seed": {
      "cache": false,
      "env": ["SANITY_API_TOKEN", "NEXT_PUBLIC_SANITY_DATASET"]
    },
    "deploy": {
      "cache": false,
      "env": ["SANITY_API_TOKEN", "NEXT_PUBLIC_SANITY_DATASET"]
    }
  }
}
