{
  "$schema": "node_modules/knip/schema.json",
  "ignoreBinaries": ["ggshield"],
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "ignore": [".agents/**"]
    },
    "apps/web": {
      "ignore": ["public/sw.js", "src/lib/sanity/sanity.types.ts"],
      "entry": ["src/routes/**/*.{ts,tsx}", "src/{router.tsx,server.ts,start.ts}"]
    },
    "packages/database": {
      "ignoreDependencies": ["tsx"],
      "drizzle": false,
      "ignoreFiles": ["drizzle.config.ts"],
      "ignoreIssues": {
        "src/db/schema/**": ["exports"]
      }
    }
  }
}
