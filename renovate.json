{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "schedule:weekly"],
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7",
      "groupName": "typescript (latest 6)"
    },
    {
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "babel-plugin-react-compiler"
      ],
      "groupName": "nextjs"
    },
    {
      "matchPackageNames": ["sanity", "@sanity/vision", "styled-components"],
      "groupName": "sanity"
    },
    {
      "matchPackageNames": ["drizzle-orm", "drizzle-kit", "pg", "@types/pg"],
      "groupName": "database"
    },
    {
      "matchPackageNames": ["turbo"],
      "enabled": false
    }
  ]
}
