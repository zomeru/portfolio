{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "schedule:weekly"],
  "packageRules": [
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=7 <8",
      "groupName": "typescript toolchain"
    },
    {
      "matchPackageNames": [
        "@tanstack/react-start",
        "@tanstack/react-router",
        "@tanstack/router-cli",
        "@cloudflare/vite-plugin",
        "vite",
        "wrangler",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "tanstack start and workers"
    },
    {
      "matchPackageNames": ["sanity", "@sanity/vision", "styled-components"],
      "groupName": "sanity"
    },
    {
      "matchPackageNames": ["drizzle-orm", "drizzle-kit", "@neondatabase/serverless"],
      "groupName": "database"
    },
    {
      "matchPackageNames": ["turbo"],
      "enabled": false
    }
  ]
}
